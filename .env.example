APP_NAME="Opsifin Scheduler"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://opsifin-cron.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opsifin_cron
DB_USERNAME=opsifin_cron
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# Kosongkan untuk akses langsung/NAT. Isi IP/CIDR forwarder HTTPS, dipisahkan koma.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=2000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Queue-focused Telescope monitoring. Access is restricted to Administrator users.
TELESCOPE_ENABLED=true
TELESCOPE_JOB_WATCHER=true
TELESCOPE_COMMAND_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_LOG_WATCHER=true
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_CLIENT_REQUEST_WATCHER=true
TELESCOPE_QUERY_WATCHER=false
TELESCOPE_MODEL_WATCHER=false

# --- Opsifin Cron ---
# Root folder repo cron legacy (berisi opsifin_crontab atau crontab.txt, configs/, jobs/, folder client)
CRON_SOURCE_PATH=/home/aditya_prasetyo/project/crontab-legacy
CRON_DEFAULT_TIMEZONE=Asia/Jakarta
CRON_RUNS_RETENTION_DAYS=90
CRON_EXECUTION_MARGIN_SEC=60

# Digunakan oleh DatabaseSeeder. Untuk produksi lebih aman memakai cron:admin-create.
ADMIN_EMAIL=
ADMIN_PASSWORD=
