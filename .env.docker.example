# Salin ke .env.docker lalu isi nilai kosong. File .env.docker tidak di-commit.
# Nilai di sini menggantikan .env host; container tidak membaca .env repo.

APP_NAME="Opsifin Scheduler"
APP_ENV=local
# Generate: docker compose run --rm --no-deps web php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8060
ASSET_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Log ke stderr supaya terbaca lewat `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Container MySQL "mysql" di network opsifin-main-networks (port internal 3306).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=opsifin_cron
DB_USERNAME=opsifin_cron
DB_PASSWORD=
DB_TIMEZONE=+07:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Container Redis "opsifin-redis" dipakai bersama opsifin-main; pakai DB index
# terpisah dan prefix sendiri agar key tidak bertabrakan.
REDIS_CLIENT=predis
REDIS_HOST=opsifin-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=opsifin_cron_
REDIS_DB=10
REDIS_CACHE_DB=11
REDIS_QUEUE_DB=12
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=2000
REDIS_QUEUE_BLOCK_FOR=5

HORIZON_NAME="Opsifin Scheduler"
HORIZON_REDIS_CONNECTION=default
HORIZON_MIN_PROCESSES=2
HORIZON_MAX_PROCESSES=10
HORIZON_LOCAL_MAX_PROCESSES=3
HORIZON_TIMEOUT=1900

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Opsifin Scheduler"

TELESCOPE_ENABLED=true
TELESCOPE_JOB_WATCHER=true
TELESCOPE_COMMAND_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_LOG_WATCHER=true
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_CLIENT_REQUEST_WATCHER=true
TELESCOPE_QUERY_WATCHER=false
TELESCOPE_MODEL_WATCHER=false

# --- Opsifin Cron ---
# Crontab legacy di-mount read-only ke /legacy oleh docker-compose.yml.
CRON_SOURCE_PATH=/legacy
CRON_DEFAULT_TIMEZONE=Asia/Jakarta
CRON_RUNS_RETENTION_DAYS=90
CRON_EXECUTION_MARGIN_SEC=60
# direct = service direct-executor; queue = service horizon (profile "queue").
CRON_EXECUTION_DRIVER=direct
CRON_DIRECT_CONCURRENCY=20
CRON_DIRECT_BATCH_LIMIT=250
CRON_DIRECT_POLL_INTERVAL_MS=500
CRON_DIRECT_START_WINDOW_SEC=55
CRON_DIRECT_HEARTBEAT_SEC=15
CRON_DIRECT_IDLE_DELAY_MS=500
CRON_DIRECT_RESPONSE_MAX_BYTES=65536
CRON_RESPONSE_EXCERPT_LENGTH=2000
CRON_CONNECTION_TEST_PATH=/api/remittanceApi

ADMIN_EMAIL=
ADMIN_PASSWORD=
