[program:opsifin-scheduler-horizon]
process_name=%(program_name)s
directory=/var/www/opsifin-scheduler
command=/usr/bin/php8.4 artisan horizon
user=opsifin_admin
numprocs=1
autostart=true
autorestart=true
startsecs=3
stopasgroup=true
killasgroup=true
stopwaitsecs=2000
redirect_stderr=true
stdout_logfile=/var/log/opsifin-scheduler/horizon.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=10
